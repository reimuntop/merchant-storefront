# Salin ke root/app/.env, atau biarkan setup-local.sh yang membuatnya.
# setup-local.sh mengisi AUTH_TOKEN_SECRET dengan nilai acak.
AUTH_TOKEN_SECRET=ganti-dengan-nilai-acak
AUTH_TOKEN_TTL_SECONDS=43200
DATABASE_URL=sqlite:////path/absolut/ke/root/app/data/shop.db
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
